---
import { pwaInfo } from 'virtual:pwa-info';
import TabBar from '../components/TabBar.astro';
import Ico from '../components/Ico.astro';
// Fuentes self-hosted (offline). Jose "Marfil": Inter Tight (titulares y
// etiquetas) + Inter (texto) + JetBrains Mono (datos). Silkscreen se queda
// para el selector de perfil.
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/inter';
import '@fontsource/silkscreen/400.css';
import '@fontsource/silkscreen/700.css';
import '@fontsource-variable/jetbrains-mono';
// Yasmina "Chai Rutine": Fraunces (títulos de cuento) + Baloo 2 (cuerpo redondeado)
import '@fontsource-variable/fraunces';
import '@fontsource/baloo-2/400.css';
import '@fontsource/baloo-2/500.css';
import '@fontsource/baloo-2/600.css';
import '@fontsource/baloo-2/700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Tu "Sistema" de entrenamiento: qué toca hoy, progresión automática de cargas y registro de progreso. PWA local-first: sin backend, sin cuentas.',
} = Astro.props;
const base = Astro.site ?? Astro.url;
const ruta = Astro.url.pathname.replace(/\/+$/, '') || '/';
const PANTALLAS: Record<string, [string, string]> = {
  '/': ['hoy', '01'],
  '/entreno': ['entreno', '02'],
  '/dieta': ['dieta', '03'],
  '/progreso': ['progreso', '04'],
};
const [pantalla, numero] = PANTALLAS[ruta] ?? ['otra', ''];
// Motas de polvo del fondo de Jose: fijas en el HTML (no aleatorias) para que
// no salten de sitio en cada recarga. Dos de ellas en oro.
const motas = Array.from({ length: 9 }, (_, i) => ({
  x: (i * 37 + 8) % 96,
  s: 1.5 + (i % 3),
  d: 18 + (i % 4) * 4,
  r: -(i * 3.3),
  oro: i === 2 || i === 6,
}));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('perfilActivo');
        } catch (e) {}
        var path = location.pathname.replace(/\/+$/, '') || '/';
        var esSelector = path === '/perfil';
        var p = esSelector ? 'selector' : stored === 'jose' || stored === 'yasmina' || stored === 'jeik' ? stored : 'jose';
        document.documentElement.dataset.perfil = p;
        document.documentElement.style.setProperty('color-scheme', 'dark');
        var tc = { jose: '#000000', yasmina: '#1d130d', jeik: '#0d1118', selector: '#000000' }[p];
        document.addEventListener('DOMContentLoaded', function () {
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', tc);
        });
        if (!stored && !esSelector) location.replace('/perfil');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, base)} />
    <meta name="apple-mobile-web-app-title" content="GYM" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="System GYM" />
    <meta property="og:title" content={`${title} · System GYM`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/web-app-manifest-512x512.png', base)} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary" />
    <title>{title} · GYM</title>
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <script src="../pwa.ts"></script>
  </head>
  <body class="min-h-dvh" data-pantalla={pantalla}>
    <div class="fondo-yasmina" aria-hidden="true"></div>
    <div class="fondo-jose" aria-hidden="true">
      <div class="fj-haz"></div>
      {
        motas.map((m) => (
          <span
            class:list={['fj-mota', { 'fj-mota-oro': m.oro }]}
            style={`--x:${m.x}%;--s:${m.s}px;--d:${m.d}s;--r:${m.r}s`}
          />
        ))
      }
    </div>
    <div class="fondo-jose-pagina" aria-hidden="true">
      <svg class="fj-halo" viewBox="0 0 300 300">
        <circle class="fj-aro" cx="150" cy="150" r="120"></circle>
        <circle class="fj-aro2" cx="150" cy="150" r="134"></circle>
      </svg>
      <div class="fj-esquirla"><i></i><i></i><i></i><i></i></div>
    </div>
    <header class="appbar sticky top-0 z-10 flex items-center justify-between bg-bg/90 px-5 pt-[calc(env(safe-area-inset-top)+0.75rem)] pb-3 backdrop-blur">
      <h1 class="text-2xl font-extrabold tracking-tight">
        {numero && <span class="appbar-n" aria-hidden="true">{numero}</span>}
        {title}
      </h1>
      <a href="/ajustes" class="-m-2 p-2 text-2xl leading-none" aria-label="Ajustes">
        <Ico id="ajustes" emoji="⚙️" px={22} />
      </a>
    </header>
    <main class="mx-auto max-w-md px-4 pb-28 pt-3">
      <slot />
    </main>
    <TabBar />
  </body>
</html>
