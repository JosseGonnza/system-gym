---
import { svgDot } from '../lib/iconos-dot';

const path = Astro.url.pathname;
// Tres variantes por pestaña: matriz de puntos (Jose), ilustración (Yasmina) y
// emoji de reserva. El CSS decide cuál se ve según el perfil.
const tabs = [
  { href: '/', label: 'Hoy', icon: '🗓️', id: 'nav-hoy' },
  { href: '/entreno', label: 'Entreno', icon: '🏋️', id: 'nav-entreno' },
  { href: '/dieta', label: 'Dieta', icon: '🍱', id: 'nav-dieta' },
  { href: '/progreso', label: 'Progreso', icon: '📊', id: 'nav-progreso' },
];
const activo = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<nav class="tabbar fixed inset-x-0 bottom-0 z-10 border-t border-line bg-surface/95 pb-[env(safe-area-inset-bottom)] backdrop-blur">
  <div class="mx-auto grid max-w-md grid-cols-4">
    {
      tabs.map((t) => {
        const on = activo(t.href);
        return (
          <a
            href={t.href}
            aria-current={on ? 'page' : undefined}
            aria-label={t.label}
            class={`tab ${t.id === 'nav-dieta' ? 'tab-dieta' : ''} has-img has-tab-dot flex flex-col items-center gap-0.5 py-2.5 text-xs font-semibold ${on ? 'tab-on text-vio-hi' : 'text-mut'}`}
          >
            <span class="tab-ico text-2xl leading-none">
              <span class="tab-dot" set:html={svgDot(t.id, 30)} />
              <img src={`/iconos/${t.id}.png`} alt="" class="tab-img" width="28" height="28" />
              <span class="tab-emoji">{t.icon}</span>
            </span>
            <span class="tab-label">{t.label}</span>
          </a>
        );
      })
    }
  </div>
</nav>
