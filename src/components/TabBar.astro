---
import { svgTrazo } from '../lib/iconos-trazo';

const path = Astro.url.pathname;

const trazo = (d: string) =>
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;

// Variantes por pestaña: línea fina (Jose), trazo de grimorio (Yasmina) y
// emoji de reserva (Jeik). El CSS decide cuál se ve según el perfil.
const LINEA: Record<string, string> = {
  'nav-hoy': trazo('<circle cx="12" cy="12" r="8" stroke-dasharray="38 12"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/>'),
  'nav-entreno': trazo('<path d="M6 7v10M18 7v10M3 10v4M21 10v4M6 12h12"/>'),
  'nav-dieta': trazo('<path d="M3 12h18a9 9 0 0 1-18 0z"/><path d="M9 8c0-1.5 1.5-1.5 1.5-3M14 8c0-1.5 1.5-1.5 1.5-3"/>'),
  'nav-progreso': trazo('<path d="M3 20h18M6 16l4-5 3 3 5-7"/>'),
};

const tabs = [
  { href: '/', label: 'Hoy', icon: '🗓️', id: 'nav-hoy' },
  { href: '/entreno', label: 'Entreno', icon: '🏋️', id: 'nav-entreno' },
  { href: '/dieta', label: 'Dieta', icon: '🍱', id: 'nav-dieta' },
  { href: '/progreso', label: 'Progreso', icon: '📊', id: 'nav-progreso' },
  // Las de Jeik: como el prototipo que aprobó. El CSS las muestra solo en su perfil.
  { href: '/dieta', label: 'Comida', icon: '🍽️', id: 'nav-comida', jeik: true },
  { href: '/domingo', label: 'Domingo', icon: '📝', id: 'nav-domingo', jeik: true },
  { href: '/plan', label: 'Plan', icon: '🧭', id: 'nav-plan', jeik: true },
];
const activo = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<nav class="tabbar fixed inset-x-0 bottom-0 z-10 border-t border-line bg-surface/95 pb-[env(safe-area-inset-bottom)] backdrop-blur">
  <div class="mx-auto grid max-w-md grid-cols-4">
    {
      tabs.map((t) => {
        const on = activo(t.href);
        return (
          <a
            href={t.href}
            aria-current={on ? 'page' : undefined}
            aria-label={t.label}
            class={`tab ${t.id === 'nav-dieta' ? 'tab-dieta' : ''} ${t.id === 'nav-progreso' ? 'tab-progreso' : ''} ${t.jeik ? 'tab-jeik' : 'has-tab-line'} flex flex-col items-center gap-0.5 py-2.5 text-xs font-semibold ${on ? 'tab-on text-vio-hi' : 'text-mut'}`}
          >
            <span class="tab-ico text-2xl leading-none">
              {!t.jeik && <span class="tab-line" set:html={LINEA[t.id]} />}
              {!t.jeik && <span class="tab-trazo" set:html={svgTrazo(t.id, 25)} />}
              <span class="tab-emoji">{t.icon}</span>
            </span>
            <span class="tab-label">{t.label}</span>
          </a>
        );
      })
    }
  </div>
</nav>
