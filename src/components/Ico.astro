---
import { hayLinea, svgLinea } from '../lib/iconos-linea';
import { hayTrazo, svgTrazo } from '../lib/iconos-trazo';

interface Props {
  id?: string;
  emoji: string;
  px?: number;
}
const { id, emoji, px = 22 } = Astro.props;
const linea = hayLinea(id);
const trazo = hayTrazo(id);
---

<span class:list={['ico', { 'has-linea': linea, 'has-trazo': trazo }]}>
  {trazo && <span class="ico-trazo-wrap" set:html={svgTrazo(id!, px)} />}
  {linea && <span class="ico-linea-wrap" set:html={svgLinea(id!, px)} />}
  <span class="ico-emoji">{emoji}</span>
</span>
