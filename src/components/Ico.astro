---
import { hayPatron, svgDot } from '../lib/iconos-dot';
import { hayTrazo, svgTrazo } from '../lib/iconos-trazo';

interface Props {
  id?: string;
  emoji: string;
  px?: number;
}
const { id, emoji, px = 22 } = Astro.props;
const dot = hayPatron(id);
const trazo = hayTrazo(id);
---

<span class:list={['ico', { 'has-dot': dot, 'has-trazo': trazo }]}>
  {trazo && <span class="ico-trazo-wrap" set:html={svgTrazo(id!, px)} />}
  {dot && <span class="ico-dot-wrap" set:html={svgDot(id!, px)} />}
  <span class="ico-emoji">{emoji}</span>
</span>
