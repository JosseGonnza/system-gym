---
import Layout from '../layouts/Layout.astro';
import Ico from '../components/Ico.astro';
---

<Layout title="Entreno">
  <section id="vista-inicio" class="hidden">
    <div class="card glow border-vio/40">
      <p class="eyebrow">Hoy toca</p>
      <h2 id="inicio-dia" class="mt-1 text-xl font-extrabold"></h2>
      <ul id="inicio-ejercicios" class="mt-3 space-y-1.5 text-sm text-mut"></ul>
      <p id="inicio-nota" class="mt-3 hidden text-xs font-semibold text-warn"></p>
      <button id="btn-empezar" class="btn mt-4">▶ Empezar entreno</button>
    </div>
  </section>

  <section id="vista-sesion" class="hidden">
    <div class="mb-3 flex items-center justify-between">
      <p id="progreso" class="eyebrow"></p>
      <div class="flex items-center gap-3 text-sm">
        <label class="flex items-center gap-1.5 text-mut">
          <Ico id="sueno" emoji="💤" px={18} />
          <input
            id="in-sueno"
            type="number"
            min="0"
            max="14"
            step="0.5"
            inputmode="decimal"
            placeholder="h"
            class="w-14 rounded-lg border border-line bg-surface2 px-1.5 py-1 text-center font-bold"
          />
        </label>
        <div id="in-energia" class="flex gap-1"></div>
      </div>
    </div>

    <div id="tarjeta"></div>

    <div class="mt-4 grid grid-cols-2 gap-2">
      <button id="btn-prev" class="btn-2 py-3">← Anterior</button>
      <button id="btn-next" class="btn py-3">Siguiente →</button>
    </div>
    <button id="btn-finalizar" class="btn-2 mt-2 border-vio/40 text-vio-hi">🏁 Finalizar sesión</button>
    <a href="/" class="mt-2 block text-center text-sm font-semibold text-mut">💾 Guardar y salir (sigue en borrador)</a>
    <textarea
      id="in-notas"
      rows="2"
      placeholder="📝 Notas: molestias, sensaciones, qué subir…"
      class="mt-4 w-full rounded-xl border border-line bg-surface px-3 py-2.5 text-sm"></textarea>
  </section>

  <section id="vista-fin" class="hidden">
    <div class="card glow border-vio/40 text-center">
      <p class="flex justify-center text-4xl"><Ico id="record" emoji="🏆" px={44} /></p>
      <h2 class="mt-2 text-xl font-extrabold">Sesión finalizada</h2>
      <p id="fin-resumen" class="mt-2 text-sm text-mut"></p>
      <ul id="fin-prs" class="mt-3 space-y-1 text-sm font-bold text-vio-hi"></ul>
      <a href="/" class="btn mt-4">Volver a Hoy</a>
    </div>
  </section>

  <div
    id="banner-pr"
    class="pointer-events-none fixed left-1/2 top-20 z-30 -translate-x-1/2 scale-90 rounded-2xl border border-vio bg-surface px-5 py-3 text-center font-extrabold text-vio-hi opacity-0 transition-all duration-300 glow"
  >
  </div>

  <div
    id="rest-bar"
    class="fixed inset-x-4 bottom-[4.7rem] z-20 hidden items-center justify-between rounded-2xl border border-vio/40 bg-surface px-4 py-3 glow"
  >
    <p class="text-sm font-bold"><span id="rest-tiempo" class="num text-lg text-vio-hi"></span> <span id="rest-nombre" class="text-mut"></span></p>
    <div class="flex gap-2">
      <button id="rest-mas" class="rounded-lg border border-line bg-surface2 px-2.5 py-1.5 text-xs font-bold">+15s</button>
      <button id="rest-saltar" class="rounded-lg border border-line bg-surface2 px-2.5 py-1.5 text-xs font-bold">Saltar</button>
    </div>
  </div>

  <div
    id="cuenta-bar"
    class="fixed inset-x-4 bottom-[4.7rem] z-30 hidden flex-col items-center rounded-2xl border border-vio bg-surface px-4 py-4 glow"
  >
    <p id="cuenta-fase" class="eyebrow"></p>
    <p id="cuenta-tiempo" class="num mt-1 text-6xl font-extrabold text-vio-hi"></p>
    <button id="cuenta-parar" class="btn-2 mt-3 py-2.5">⏹ Parar</button>
  </div>

  <dialog
    id="dlg-borrador"
    class="m-auto w-[88%] max-w-sm rounded-2xl border border-line bg-surface p-5 text-ink backdrop:bg-black/70"
  >
    <h3 class="text-lg font-extrabold">Tienes una sesión a medias</h3>
    <p id="dlg-borrador-texto" class="mt-2 text-sm text-mut"></p>
    <div class="mt-4 grid gap-2">
      <button id="dlg-borrador-retomar" class="btn">▶ Retomar</button>
      <button id="dlg-borrador-descartar" class="btn-2 text-bad">🗑 Descartar</button>
    </div>
  </dialog>
</Layout>

<script>
  import {
    initDB,
    getConfig,
    getCatalogo,
    getRutinas,
    setRutinas,
    getSesiones,
    getDiario,
    hoyISO,
    diaSugerido,
    formatObjetivo,
  } from '../lib/db';
  import { pesoReal, muestraPesoReal, fmtKg } from '../lib/carga';
  import { iconoEl, iconoDeDia } from '../lib/iconos';
  import { sugerir, historialDeRanura, type Sugerencia } from '../lib/motor';
  import { tipDe } from '../lib/tips';
  import {
    CAMPOS,
    OBJETIVOS_MIN,
    arrancarCrono,
    camposDe,
    esCardio,
    maquinaPorDefecto,
    pararCrono,
    precargar,
    segundosCrono,
    ultimoCardio,
  } from '../lib/cardio';
  import {
    crearSesion,
    guardarSesion,
    descartarSesion,
    finalizarSesion,
    buscarBorrador,
    cerrarBorradoresCaducados,
  } from '../lib/sesion';
  import type {
    DatosCardio,
    DiaDef,
    Ejercicio,
    EjercicioDef,
    EjercicioReg,
    EstadoSerie,
    SerieReg,
    Sesion,
  } from '../lib/types';

  const $ = (id: string) => document.getElementById(id)!;

  await initDB();
  await cerrarBorradoresCaducados();
  const config = await getConfig();
  const catalogo = await getCatalogo();
  const catalogoMap = new Map(catalogo.map((x) => [x.id, x]));
  const rutinas = await getRutinas();
  const rutina = rutinas.find((r) => r.id === config.rutinaActivaId) ?? rutinas[0];
  const sesiones = await getSesiones();
  const diario = await getDiario();
  const hoy = hoyISO();

  let sesion: Sesion | null = null;
  let dia: DiaDef = rutina.dias.find((d) => d.id === diario[hoy]?.diaElegidoId) ?? diaSugerido(config, rutina);
  let cardIdx = 0;
  const prsLogrados: string[] = [];

  const tituloDe = (d: DiaDef) => d.nombre;

  // Mejores marcas históricas por ranura, para detectar récords
  const bests = new Map<string, { peso: number; lastre: number; reps: number; seg: number }>();
  for (const s of sesiones) {
    if (s.estado !== 'finalizada') continue;
    for (const er of s.ejercicios) {
      for (const sr of er.series) {
        if (sr.estado !== 'completada') continue;
        const b = bests.get(er.ranuraId) ?? { peso: 0, lastre: 0, reps: 0, seg: 0 };
        b.peso = Math.max(b.peso, sr.peso ?? 0);
        if ((sr.lastreKg ?? 0) > b.lastre) {
          b.lastre = sr.lastreKg ?? 0;
          b.reps = sr.reps ?? 0;
        } else if ((sr.lastreKg ?? 0) === b.lastre) {
          b.reps = Math.max(b.reps, sr.reps ?? 0);
        }
        b.seg = Math.max(b.seg, sr.segundos ?? 0);
        bests.set(er.ranuraId, b);
      }
    }
  }

  // Las máquinas de cardio seguidas van en una sola tarjeta con pestañas: se hace
  // una (o dos), no todas.
  function grupos(d: DiaDef): EjercicioDef[][] {
    const out: EjercicioDef[][] = [];
    for (const e of d.ejercicios) {
      const prev = out[out.length - 1];
      const superserie = !!e.superserieId && prev?.[0].superserieId === e.superserieId;
      const cardio = esCardio(e.ejercicioId) && !!prev && esCardio(prev[0].ejercicioId);
      if (superserie || cardio) prev.push(e);
      else out.push([e]);
    }
    return out;
  }

  const esGrupoCardio = (g: EjercicioDef[]) => esCardio(g[0].ejercicioId);
  const cardioUsado = (s: SerieReg) =>
    s.estado !== 'pendiente' || !!s.cardio?.cronoInicioISO || (s.cardio?.cronoAcumSeg ?? 0) > 0;

  // Máquina abierta en cada tarjeta de cardio (clave: su primera ranura)
  const maquinaSel = new Map<string, string>();
  function maquinaDe(g: EjercicioDef[]): EjercicioDef {
    const clave = g[0].ranuraId;
    if (!maquinaSel.has(clave)) {
      const usada = g.find((e) => cardioUsado(regDe(e).series[0]));
      maquinaSel.set(clave, usada?.ranuraId ?? maquinaPorDefecto(sesiones, g.map((e) => e.ranuraId)));
    }
    return g.find((e) => e.ranuraId === maquinaSel.get(clave)) ?? g[0];
  }

  // Las máquinas de cardio que no se han tocado no son series pendientes.
  function seriesContables(): SerieReg[] {
    return grupos(dia).flatMap((g) => {
      if (!esGrupoCardio(g)) return g.flatMap((e) => regDe(e).series);
      const usadas = g.filter((e) => cardioUsado(regDe(e).series[0]));
      return (usadas.length ? usadas : [maquinaDe(g)]).flatMap((e) => regDe(e).series);
    });
  }

  function calcularSugerencias(d: DiaDef): Map<string, Sugerencia> {
    const map = new Map<string, Sugerencia>();
    for (const e of d.ejercicios) {
      map.set(e.ranuraId, sugerir(e, historialDeRanura(sesiones, e.ranuraId), config.incrementoMinimoKg));
    }
    return map;
  }

  function mostrarVista(v: 'inicio' | 'sesion' | 'fin') {
    for (const x of ['inicio', 'sesion', 'fin']) $(`vista-${x}`).classList.toggle('hidden', x !== v);
  }

  // ---------- Vista inicio ----------
  function renderInicio() {
    const elInicio = $('inicio-dia');
    elInicio.classList.add('flex', 'items-center', 'gap-2');
    elInicio.replaceChildren(iconoEl(iconoDeDia(rutina.dias, dia), dia.emoji, 24), dia.nombre);
    $('inicio-ejercicios').replaceChildren(
      ...dia.ejercicios.map((e) => {
        const li = document.createElement('li');
        li.className = 'flex justify-between gap-3';
        const n = document.createElement('span');
        if (e.superserieId) {
          n.className = 'flex items-center gap-1.5';
          n.replaceChildren(iconoEl('superserie', '🔁', 14), e.nombre);
        } else {
          n.textContent = e.nombre;
        }
        const o = document.createElement('span');
        o.className = 'shrink-0 font-semibold text-vio-soft';
        o.textContent = formatObjetivo(e);
        li.append(n, o);
        return li;
      }),
    );
    const nota = $('inicio-nota');
    if (diario[hoy]?.descanso) {
      nota.textContent = '😴 Hoy lo tienes marcado como descanso. Si entrenas, quítalo luego en Hoy.';
      nota.classList.remove('hidden');
    } else if (sesiones.some((s) => s.fecha === hoy && s.estado === 'finalizada')) {
      nota.textContent = '✅ Hoy ya has finalizado una sesión.';
      nota.classList.remove('hidden');
    }
    mostrarVista('inicio');
  }

  // ---------- Vista sesión ----------
  function regDe(e: EjercicioDef): EjercicioReg {
    return sesion!.ejercicios.find((x) => x.ranuraId === e.ranuraId)!;
  }

  function renderProgreso() {
    const gs = grupos(dia);
    const elP = $('progreso');
    elP.classList.add('flex', 'items-center', 'gap-1.5');
    elP.replaceChildren(iconoEl(iconoDeDia(rutina.dias, dia), dia.emoji, 16), `${dia.nombre} · ${cardIdx + 1}/${gs.length}`);
    ($('btn-prev') as HTMLButtonElement).disabled = cardIdx === 0;
    $('btn-prev').classList.toggle('opacity-40', cardIdx === 0);
    $('btn-next').textContent = cardIdx === gs.length - 1 ? '🏁 Finalizar' : 'Siguiente →';
  }

  function renderEnergia() {
    $('in-energia').replaceChildren(
      ...[1, 2, 3, 4, 5].map((n) => {
        const b = document.createElement('button');
        const activo = sesion!.energia != null && n <= sesion!.energia;
        b.className = `flex h-7 w-7 items-center justify-center rounded-lg border text-xs font-bold transition active:scale-90 ${
          activo ? 'border-vio bg-vio/30 text-vio-hi' : 'border-line bg-surface2 text-mut'
        }`;
        b.replaceChildren(iconoEl('energia', '⚡', 15));
        b.addEventListener('click', () => {
          sesion!.energia = sesion!.energia === n ? null : n;
          void guardarSesion(sesion!);
          renderEnergia();
        });
        return b;
      }),
    );
  }

  function inputNum(valor: number | null, ancho: string, placeholder: string, onCambio: (v: number | null) => void) {
    const i = document.createElement('input');
    i.type = 'number';
    i.inputMode = 'decimal';
    i.step = 'any';
    i.placeholder = placeholder;
    i.value = valor != null ? String(valor) : '';
    i.className = `${ancho} num rounded-lg border border-line bg-surface2 px-1 py-2 text-center text-base font-bold`;
    i.addEventListener('change', () => {
      const v = i.value === '' ? null : Number(i.value);
      onCambio(Number.isFinite(v as number) ? v : null);
      void guardarSesion(sesion!);
    });
    return i;
  }

  function checkPR(e: EjercicioDef, i: number) {
    const s = regDe(e).series[i];
    const b = bests.get(e.ranuraId);
    if (!b) return;
    let logrado: string | null = null;
    if (e.tipoProgresion === 'tiempo') {
      if (b.seg > 0 && (s.segundos ?? 0) > b.seg) {
        logrado = esCardio(e.ejercicioId)
          ? `${e.nombre}: ${Math.round(s.segundos! / 60)} min`
          : `${e.nombre}: ${s.segundos} s`;
        b.seg = s.segundos!;
      }
    } else if (e.tipoProgresion === 'pesoCorporal') {
      const lastre = s.lastreKg ?? 0;
      if (lastre > b.lastre || (lastre === b.lastre && (s.reps ?? 0) > b.reps)) {
        logrado = `${e.nombre}: ${lastre ? `+${lastre} kg × ` : ''}${s.reps} reps`;
        b.lastre = lastre;
        b.reps = s.reps ?? 0;
      }
    } else if ((s.peso ?? 0) > b.peso) {
      logrado = `${e.nombre}: ${s.peso} kg`;
      b.peso = s.peso!;
    }
    if (logrado) {
      prsLogrados.push(logrado);
      const banner = $('banner-pr');
      banner.replaceChildren(iconoEl('record', '🏆', 18), ` NUEVO RÉCORD · ${logrado}`);
      banner.classList.remove('opacity-0', 'scale-90');
      setTimeout(() => banner.classList.add('opacity-0', 'scale-90'), 2500);
    }
  }

  function marcar(e: EjercicioDef, i: number, estado: EstadoSerie) {
    const s = regDe(e).series[i];
    registrar(e, i, s.estado === estado ? 'pendiente' : estado);
  }

  function registrar(e: EjercicioDef, i: number, estado: EstadoSerie) {
    const s = regDe(e).series[i];
    s.estado = estado;
    if (s.estado !== 'pendiente') {
      const ahora = new Date().toISOString();
      sesion!.inicioISO ??= ahora;
      sesion!.finISO = ahora;
      if (s.estado === 'completada') checkPR(e, i);
      empezarRest(e);
    }
    void guardarSesion(sesion!);
    renderCard();
  }

  function bloqueEjercicio(e: EjercicioDef): HTMLElement {
    const reg = regDe(e);
    const sug = sugerir(e, historialDeRanura(sesiones, e.ranuraId), config.incrementoMinimoKg);
    const ej = e.ejercicioId ? catalogoMap.get(e.ejercicioId) : undefined;
    const conReal = !!ej && muestraPesoReal(ej.entrada) && e.tipoProgresion !== 'tiempo' && e.tipoProgresion !== 'pesoCorporal';
    const div = document.createElement('div');

    const head = document.createElement('div');
    head.className = 'flex items-start justify-between gap-2';
    const h = document.createElement('h3');
    h.className = 'text-lg font-extrabold';
    h.textContent = e.nombre;
    const rest = document.createElement('div');
    rest.className = 'flex items-center gap-1 text-xs font-bold text-mut';
    const menos = document.createElement('button');
    menos.textContent = '−';
    const masB = document.createElement('button');
    masB.textContent = '+';
    for (const b of [menos, masB]) b.className = 'h-6 w-6 rounded-md border border-line bg-surface2';
    const restTxt = document.createElement('span');
    restTxt.textContent = `⏱ ${e.restSeg}s`;
    menos.addEventListener('click', async () => {
      e.restSeg = Math.max(15, e.restSeg - 15);
      restTxt.textContent = `⏱ ${e.restSeg}s`;
      await setRutinas(rutinas);
    });
    masB.addEventListener('click', async () => {
      e.restSeg += 15;
      restTxt.textContent = `⏱ ${e.restSeg}s`;
      await setRutinas(rutinas);
    });
    rest.append(menos, restTxt, masB);
    head.append(h, rest);
    div.append(head);

    const chip = document.createElement('p');
    chip.className = 'mt-1 inline-block rounded-lg bg-vio/15 px-2 py-1 text-xs font-bold text-vio-hi';
    chip.textContent = `${formatObjetivo(e)} · ${sug.texto}`;
    div.append(chip);

    if (sug.aviso) {
      const aviso = document.createElement('p');
      aviso.className = 'mt-1.5 text-xs font-semibold text-warn';
      aviso.textContent = `⚠️ ${sug.aviso}`;
      div.append(aviso);
    }
    if (e.nota) {
      const nota = document.createElement('p');
      nota.className = 'mt-1.5 flex items-center gap-1.5 text-xs text-mut';
      nota.replaceChildren(iconoEl('nota', '💡', 15), `${e.nota}`);
      div.append(nota);
    }
    if (ej?.agarre) {
      const ag = document.createElement('p');
      ag.className = 'mt-1.5 text-xs text-mut';
      ag.textContent = `🤚 Agarre: ${ej.agarre}`;
      div.append(ag);
    }

    div.append(...tipEl(e.ejercicioId));

    const lista = document.createElement('div');
    lista.className = 'mt-3 space-y-2';
    reg.series.forEach((s, i) => lista.append(filaSerie(e, ej, conReal, s, i)));
    div.append(lista);

    // Tiempo fijo (plancha): la serie se hace con cuenta atrás, sin teclear
    const siguiente = reg.series.findIndex((s) => s.estado === 'pendiente');
    if (e.tipoProgresion === 'tiempo' && e.segObjetivo && siguiente >= 0) {
      const play = document.createElement('button');
      play.className = 'btn mt-3 py-3';
      play.textContent = `▶ Serie ${siguiente + 1} · ${fmtCrono(e.segObjetivo)}`;
      play.addEventListener('click', () => empezarCuenta(e, siguiente));
      div.append(play);
    }
    return div;
  }

  function tipEl(ejercicioId?: string): HTMLElement[] {
    const tip = tipDe(ejercicioId);
    if (!tip) return [];
    const btn = document.createElement('button');
    btn.className =
      'mt-2 flex items-center gap-1.5 rounded-lg border border-line bg-surface2 px-2.5 py-1.5 text-xs font-bold text-mut transition active:scale-[.97]';
    btn.setAttribute('aria-expanded', 'false');
    btn.replaceChildren(iconoEl('nota', '💡', 15), 'Cómo se hace');

    const panel = document.createElement('div');
    panel.className = 'mt-2 hidden rounded-xl border border-line bg-surface2 p-3 text-xs';
    const donde = document.createElement('p');
    donde.className = 'font-bold text-vio-hi';
    donde.textContent = `Lo tienes que notar en: ${tip.donde}`;
    const ul = document.createElement('ul');
    ul.className = 'mt-2 space-y-1 text-mut';
    ul.replaceChildren(
      ...tip.claves.map((c) => {
        const li = document.createElement('li');
        li.className = 'flex gap-2';
        const p = document.createElement('span');
        p.textContent = '·';
        const t = document.createElement('span');
        t.textContent = c;
        li.append(p, t);
        return li;
      }),
    );
    panel.append(donde, ul);
    if (tip.error) {
      const err = document.createElement('p');
      err.className = 'mt-2 border-t border-line pt-2 font-semibold text-warn';
      err.textContent = tip.error;
      panel.append(err);
    }

    btn.addEventListener('click', () => {
      const abierto = !panel.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(abierto));
    });
    return [btn, panel];
  }

  function filaSerie(e: EjercicioDef, ej: Ejercicio | undefined, conReal: boolean, s: SerieReg, i: number): HTMLElement {
    const wrap = document.createElement('div');
    const fila = document.createElement('div');
    fila.className = 'flex items-center gap-2';
    const num = document.createElement('span');
    num.className = 'w-6 shrink-0 text-xs font-bold text-mut';
    num.textContent = `S${i + 1}`;
    fila.append(num);

    let real: HTMLElement | null = null;
    if (e.tipoProgresion === 'tiempo') {
      // El cardio se pide en minutos (nadie escribe 1800); por dentro sigue
      // guardándose en segundos, como la plancha.
      const enMin = esCardio(e.ejercicioId) || ej?.patron === 'cardio';
      const valor = s.segundos == null ? null : enMin ? Math.round(s.segundos / 60) : s.segundos;
      fila.append(
        inputNum(valor, 'w-20', enMin ? 'min' : 'seg', (v) => (s.segundos = v == null ? null : enMin ? v * 60 : v)),
      );
      const lbl = document.createElement('span');
      lbl.className = 'text-xs text-mut';
      lbl.textContent = enMin ? 'min' : 's';
      fila.append(lbl);
    } else if (e.tipoProgresion === 'pesoCorporal') {
      fila.append(inputNum(s.lastreKg ?? null, 'w-18', '+kg', (v) => (s.lastreKg = v)));
      const x = document.createElement('span');
      x.className = 'text-xs text-mut';
      x.textContent = '×';
      fila.append(x, inputNum(s.reps ?? null, 'w-16', 'reps', (v) => (s.reps = v)));
    } else {
      const inPeso = inputNum(s.peso ?? null, 'w-20', 'kg', (v) => (s.peso = v));
      fila.append(inPeso);
      const x = document.createElement('span');
      x.className = 'text-xs text-mut';
      x.textContent = '×';
      fila.append(x, inputNum(s.reps ?? null, 'w-16', 'reps', (v) => (s.reps = v)));
      if (conReal && ej) {
        real = document.createElement('p');
        real.className = 'num ml-8 mt-0.5 text-xs font-semibold text-vio-soft';
        const pinta = () => {
          const v = inPeso.value === '' ? null : Number(inPeso.value);
          const r = pesoReal(ej, Number.isFinite(v as number) ? v : null);
          real!.textContent = r != null ? `= ${fmtKg(r)} kg reales` : '';
        };
        pinta();
        inPeso.addEventListener('input', pinta);
      }
    }

    const estados = document.createElement('div');
    estados.className = 'ml-auto flex gap-1';
    const defs: { id: EstadoSerie; icono: string; on: string }[] = [
      { id: 'completada', icono: '✓', on: 'border-ok bg-ok/20 text-ok' },
      { id: 'fallo', icono: '🔥', on: 'border-warn bg-warn/20' },
      { id: 'corta', icono: '✗', on: 'border-bad bg-bad/20 text-bad' },
    ];
    for (const d of defs) {
      const b = document.createElement('button');
      b.className = `h-10 w-10 rounded-xl border text-base font-bold transition active:scale-90 ${
        s.estado === d.id ? d.on : 'border-line bg-surface2 text-mut'
      }`;
      b.textContent = d.icono;
      b.addEventListener('click', () => marcar(e, i, d.id));
      estados.append(b);
    }
    fila.append(estados);
    wrap.append(fila);
    if (real) wrap.append(real);
    return wrap;
  }

  // ---------- Cardio ----------
  const fmtCrono = (seg: number) => {
    const t = Math.max(0, Math.floor(seg));
    return `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`;
  };
  const fmtDato = (n: number) => n.toLocaleString('es-ES', { maximumFractionDigits: 2 });

  // Ranura de cardio que se ve ahora en pantalla (para pintar su crono)
  let cardioVisible: string | null = null;

  function bloqueCardio(g: EjercicioDef[]): HTMLElement {
    const e = maquinaDe(g);
    const s = regDe(e).series[0];
    const ej = e.ejercicioId ? catalogoMap.get(e.ejercicioId) : undefined;
    const ultimo = ultimoCardio(sesiones, e.ranuraId);
    if (!s.cardio) {
      s.cardio = precargar(ultimo?.cardio ?? null);
      // Los minutos salen del crono: la sugerencia de +5 s no pinta nada aquí
      if (s.estado === 'pendiente') s.segundos = null;
    }
    const c: DatosCardio = s.cardio;
    const corriendo = !!c.cronoInicioISO;
    const guardarYPintar = () => {
      void guardarSesion(sesion!);
      renderCard();
    };
    cardioVisible = e.ranuraId;
    const div = document.createElement('div');

    if (g.length > 1) {
      const tabs = document.createElement('div');
      tabs.className = 'mb-3 grid gap-1.5';
      tabs.style.gridTemplateColumns = `repeat(${g.length}, minmax(0, 1fr))`;
      for (const m of g) {
        const activa = m.ranuraId === e.ranuraId;
        const b = document.createElement('button');
        b.className = `rounded-lg border px-1 py-2 text-xs font-bold transition active:scale-95 ${
          activa ? 'border-vio bg-vio/20 text-vio-hi' : 'border-line bg-surface2 text-mut'
        } ${corriendo && !activa ? 'opacity-40' : ''}`;
        b.textContent = m.nombre;
        // Con el crono en marcha no se cambia de máquina: primero se termina
        b.disabled = corriendo && !activa;
        b.addEventListener('click', () => {
          maquinaSel.set(g[0].ranuraId, m.ranuraId);
          renderCard();
        });
        tabs.append(b);
      }
      div.append(tabs);
    }

    const h = document.createElement('h3');
    h.className = 'text-lg font-extrabold';
    h.textContent = e.nombre;
    div.append(h);
    if (ultimo) {
      const datos = [
        ultimo.segundos ? `${Math.round(ultimo.segundos / 60)} min` : null,
        ...camposDe(e.ejercicioId).map((k) =>
          ultimo.cardio?.[k] != null ? `${fmtDato(ultimo.cardio[k]!)}${CAMPOS[k].unidad ? ` ${CAMPOS[k].unidad}` : ''}` : null,
        ),
      ].filter(Boolean);
      const p = document.createElement('p');
      p.className = 'mt-1 text-xs font-semibold text-vio-soft';
      p.textContent = `Último día: ${datos.join(' · ') || 'sin datos'}`;
      div.append(p);
    }
    if (e.nota) {
      const nota = document.createElement('p');
      nota.className = 'mt-1.5 flex items-center gap-1.5 text-xs text-mut';
      nota.replaceChildren(iconoEl('nota', '💡', 15), e.nota);
      div.append(nota);
    }
    div.append(...tipEl(e.ejercicioId));

    // Objetivo: se elige antes de subir y se va a por él
    const obj = document.createElement('div');
    obj.className = 'mt-4 flex items-center gap-1.5';
    const objLbl = document.createElement('span');
    objLbl.className = 'mr-1 text-xs font-bold text-mut';
    objLbl.textContent = 'Objetivo';
    obj.append(objLbl);
    for (const m of OBJETIVOS_MIN) {
      const b = document.createElement('button');
      b.className = `h-10 flex-1 rounded-xl border text-sm font-bold transition active:scale-95 ${
        c.objetivoMin === m ? 'border-vio bg-vio/20 text-vio-hi' : 'border-line bg-surface2 text-mut'
      }`;
      b.textContent = `${m}'`;
      b.addEventListener('click', () => {
        c.objetivoMin = m;
        guardarYPintar();
      });
      obj.append(b);
    }
    const otro = inputNum(OBJETIVOS_MIN.includes(c.objetivoMin ?? 0) ? null : (c.objetivoMin ?? null), 'w-16', 'otro', (v) => {
      c.objetivoMin = v;
      renderCard();
    });
    obj.append(otro);
    div.append(obj);

    const reloj = document.createElement('div');
    reloj.className = 'mt-4 text-center';
    const tiempo = document.createElement('p');
    tiempo.id = 'crono-cardio';
    tiempo.className = 'num text-6xl font-extrabold text-vio-hi';
    const sub = document.createElement('p');
    sub.id = 'crono-cardio-sub';
    sub.className = 'mt-1 text-xs font-semibold text-mut';
    reloj.append(tiempo, sub);
    div.append(reloj);

    const mandos = document.createElement('div');
    mandos.className = 'mt-3 grid grid-cols-2 gap-2';
    const usado = (c.cronoAcumSeg ?? 0) > 0 || corriendo;
    const btn = (txt: string, clase: string, accion: () => void) => {
      const b = document.createElement('button');
      b.className = clase;
      b.textContent = txt;
      b.addEventListener('click', accion);
      return b;
    };
    if (corriendo) {
      mandos.append(
        btn('⏸ Pausa', 'btn-2 py-3', () => {
          pararCrono(c);
          if (!necesitaPantalla()) soltarPantalla();
          guardarYPintar();
        }),
        btn('⏹ Terminar', 'btn py-3', () => terminarCardio(e, s)),
      );
    } else {
      const play = btn(usado ? '▶ Seguir' : '▶ Empezar', 'btn py-3', () => {
        asegurarAudio();
        pararRest();
        arrancarCrono(c);
        const ahora = new Date().toISOString();
        sesion!.inicioISO ??= ahora;
        sesion!.finISO = ahora;
        void pedirPantalla();
        guardarYPintar();
        tickCardio();
        cardioInterval ??= setInterval(tickCardio, 500);
      });
      if (usado) mandos.append(play, btn('⏹ Terminar', 'btn-2 py-3', () => terminarCardio(e, s)));
      else {
        play.classList.add('col-span-2');
        mandos.append(play);
      }
    }
    div.append(mandos);

    const campos = document.createElement('div');
    campos.className = 'mt-4 grid grid-cols-2 gap-2';
    for (const k of camposDe(e.ejercicioId)) {
      const def = CAMPOS[k];
      const lab = document.createElement('label');
      lab.className = 'block';
      const t = document.createElement('span');
      t.className = 'text-[11px] font-bold text-mut';
      t.textContent = def.unidad ? `${def.label} (${def.unidad})` : def.label;
      const previo = ultimo?.cardio?.[k];
      const input = inputNum(c[k] ?? null, 'mt-1 w-full', previo != null ? `últ. ${fmtDato(previo)}` : '—', (v) => (c[k] = v));
      lab.append(t, input);
      campos.append(lab);
    }
    div.append(campos);

    const esf = document.createElement('div');
    esf.className = 'mt-3';
    const esfLbl = document.createElement('p');
    esfLbl.className = 'text-[11px] font-bold text-mut';
    esfLbl.textContent = 'Esfuerzo (1-10)';
    const esfFila = document.createElement('div');
    esfFila.className = 'mt-1 grid grid-cols-10 gap-1';
    for (let n = 1; n <= 10; n++) {
      const b = document.createElement('button');
      b.className = `h-8 rounded-lg border text-xs font-bold transition active:scale-90 ${
        c.esfuerzo === n ? 'border-vio bg-vio/30 text-vio-hi' : 'border-line bg-surface2 text-mut'
      }`;
      b.textContent = String(n);
      b.addEventListener('click', () => {
        c.esfuerzo = c.esfuerzo === n ? null : n;
        guardarYPintar();
      });
      esfFila.append(b);
    }
    esf.append(esfLbl, esfFila);
    div.append(esf);

    const manual = document.createElement('p');
    manual.className = 'mt-4 text-[11px] font-bold text-mut';
    manual.textContent = '¿Sin crono? Apunta los minutos a mano:';
    div.append(manual, filaSerie(e, ej, false, s, 0));
    return div;
  }

  function terminarCardio(e: EjercicioDef, s: SerieReg) {
    const c = s.cardio!;
    pararCrono(c);
    if (!necesitaPantalla()) soltarPantalla();
    const seg = Math.round(c.cronoAcumSeg ?? 0);
    // Menos de un minuto es haberle dado sin querer: se descarta
    if (seg < 60) {
      c.cronoAcumSeg = 0;
      void guardarSesion(sesion!);
      renderCard();
      return;
    }
    s.segundos = seg;
    registrar(e, 0, 'completada');
  }

  function pintarCronoCardio(c: DatosCardio) {
    const tiempo = document.getElementById('crono-cardio');
    const sub = document.getElementById('crono-cardio-sub');
    if (!tiempo || !sub) return;
    const seg = segundosCrono(c);
    const obj = (c.objetivoMin ?? 0) * 60;
    const pausa = c.cronoInicioISO ? '' : (c.cronoAcumSeg ?? 0) > 0 ? ' · en pausa' : '';
    tiempo.classList.toggle('text-ok', obj > 0 && seg >= obj);
    tiempo.classList.toggle('text-vio-hi', !(obj > 0 && seg >= obj));
    if (obj > 0 && seg < obj) {
      tiempo.textContent = fmtCrono(obj - seg);
      sub.textContent = `quedan de ${c.objetivoMin} min${pausa}`;
    } else if (obj > 0) {
      // Llegar al objetivo no para: lo que sigas es extra y se apunta
      tiempo.textContent = `+${fmtCrono(seg - obj)}`;
      sub.textContent = `✓ objetivo de ${c.objetivoMin} min cumplido · llevas ${fmtCrono(seg)}${pausa}`;
    } else {
      tiempo.textContent = fmtCrono(seg);
      sub.textContent = `sin objetivo${pausa}`;
    }
  }

  let cardioInterval: ReturnType<typeof setInterval> | undefined;
  const avisados = new Set<string>();

  function cronosCardio(): { e: EjercicioDef; c: DatosCardio }[] {
    if (!sesion) return [];
    return dia.ejercicios
      .filter((e) => esCardio(e.ejercicioId))
      .map((e) => ({ e, c: regDe(e)?.series[0]?.cardio }))
      .filter((x): x is { e: EjercicioDef; c: DatosCardio } => !!x.c);
  }

  // Pita aunque la tarjeta no esté a la vista; solo pinta la que se ve.
  function tickCardio() {
    let alguno = false;
    for (const { e, c } of cronosCardio()) {
      const obj = (c.objetivoMin ?? 0) * 60;
      if (c.cronoInicioISO) alguno = true;
      if (obj > 0 && segundosCrono(c) >= obj) {
        if (c.cronoInicioISO && !avisados.has(e.ranuraId)) {
          avisados.add(e.ranuraId);
          pitidoObjetivo();
        }
      } else {
        avisados.delete(e.ranuraId);
      }
      if (cardioVisible === e.ranuraId) pintarCronoCardio(c);
    }
    if (!alguno && cardioInterval) {
      clearInterval(cardioInterval);
      cardioInterval = undefined;
    }
  }

  function renderCard() {
    const gs = grupos(dia);
    const grupo = gs[cardIdx];
    const card = document.createElement('div');
    card.className = 'card glow border-vio/30';
    cardioVisible = null;
    if (esGrupoCardio(grupo)) {
      card.append(bloqueCardio(grupo));
      $('tarjeta').replaceChildren(card);
      renderProgreso();
      tickCardio();
      if (cronosCardio().some(({ c }) => c.cronoInicioISO)) cardioInterval ??= setInterval(tickCardio, 500);
      return;
    }
    if (grupo.length > 1) {
      const tag = document.createElement('p');
      tag.className = 'eyebrow mb-2 block';
      tag.className += ' flex items-center gap-1.5';
      tag.replaceChildren(iconoEl('superserie', '🔁', 15), 'Superserie — alterna sin descanso entre ambos');
      card.append(tag);
    }
    grupo.forEach((e, i) => {
      if (i > 0) {
        const hr = document.createElement('hr');
        hr.className = 'my-4 border-line';
        card.append(hr);
      }
      card.append(bloqueEjercicio(e));
    });
    $('tarjeta').replaceChildren(card);
    renderProgreso();
  }

  function renderSesion() {
    ($('in-sueno') as HTMLInputElement).value = sesion!.suenoH != null ? String(sesion!.suenoH) : '';
    ($('in-notas') as HTMLTextAreaElement).value = sesion!.notas;
    renderEnergia();
    renderCard();
    mostrarVista('sesion');
    // Retomar un borrador con el crono de cardio en marcha
    if (cronosCardio().some(({ c }) => c.cronoInicioISO)) {
      asegurarAudio();
      cardioInterval ??= setInterval(tickCardio, 500);
      void pedirPantalla();
    }
  }

  // ---------- Vista fin ----------
  function renderFin() {
    const contables = seriesContables();
    const total = contables.length;
    const hechasN = contables.filter((s) => s.estado !== 'pendiente').length;
    const dur = sesion!.duracionMin != null ? ` · ${sesion!.duracionMin} min` : '';
    const elF = $('fin-resumen');
    elF.classList.add('flex', 'flex-wrap', 'items-center', 'justify-center', 'gap-1.5');
    elF.replaceChildren(iconoEl(iconoDeDia(rutina.dias, dia), dia.emoji, 16), `${dia.nombre} · ${hechasN}/${total} series${dur}`);
    $('fin-prs').replaceChildren(
      ...prsLogrados.map((p) => {
        const li = document.createElement('li');
        li.textContent = `⬆ ${p}`;
        return li;
      }),
    );
    mostrarVista('fin');
  }

  // ---------- Rest timer ----------
  // Basado en reloj de pared: con la pantalla bloqueada los intervals se congelan,
  // así que el fin es un timestamp y se resincroniza al volver a la app.
  let restInterval: ReturnType<typeof setInterval> | undefined;
  let restFinMs = 0;
  let audioCtx: AudioContext | null = null;

  function bip(frecuencia = 880, duracion = 0.25) {
    try {
      if (!audioCtx) return;
      const osc = audioCtx.createOscillator();
      osc.frequency.value = frecuencia;
      osc.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + duracion);
    } catch {
      /* sin audio, la vibración basta */
    }
  }

  function pitido() {
    navigator.vibrate?.([200, 100, 200]);
    bip();
  }

  function pitidoObjetivo() {
    navigator.vibrate?.([400, 150, 400, 150, 400]);
    bip(880, 0.6);
  }

  // El AudioContext se crea en un gesto del usuario; si no, el navegador lo bloquea
  function asegurarAudio() {
    if (audioCtx) return;
    try {
      audioCtx = new AudioContext();
    } catch {
      audioCtx = null;
    }
  }

  // ---------- Pantalla encendida ----------
  // Solo mientras corre una cuenta atrás. Si cambias de app se suelta solo, y
  // se vuelve a pedir al volver.
  let wakeLock: WakeLockSentinel | null = null;

  async function pedirPantalla() {
    if (wakeLock || !('wakeLock' in navigator)) return;
    try {
      wakeLock = await navigator.wakeLock.request('screen');
      wakeLock.addEventListener('release', () => (wakeLock = null));
    } catch {
      /* sin permiso o sin batería: el crono sigue igual */
    }
  }

  function soltarPantalla() {
    void wakeLock?.release();
    wakeLock = null;
  }

  const necesitaPantalla = () => cuenta != null || cronosCardio().some(({ c }) => c.cronoInicioISO);

  function pintarRest(restante: number) {
    const m = Math.floor(restante / 60);
    const s = restante % 60;
    $('rest-tiempo').textContent = `${m}:${String(s).padStart(2, '0')}`;
  }

  function pararRest() {
    clearInterval(restInterval);
    restFinMs = 0;
    $('rest-bar').classList.add('hidden');
    $('rest-bar').classList.remove('flex');
  }

  function tickRest() {
    if (!restFinMs) return;
    const restante = Math.ceil((restFinMs - Date.now()) / 1000);
    if (restante <= 0) {
      pararRest();
      pitido();
    } else {
      pintarRest(restante);
    }
  }

  function empezarRest(e: EjercicioDef) {
    if (!config.restTimerActivo || e.restSeg <= 0) return;
    asegurarAudio();
    clearInterval(restInterval);
    restFinMs = Date.now() + e.restSeg * 1000;
    $('rest-nombre').textContent = `· ${e.nombre}`;
    $('rest-bar').classList.remove('hidden');
    $('rest-bar').classList.add('flex');
    tickRest();
    restInterval = setInterval(tickRest, 500);
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) return;
    tickRest();
    tickCuenta();
    tickCardio();
    if (necesitaPantalla()) void pedirPantalla();
  });

  $('rest-saltar').addEventListener('click', pararRest);
  $('rest-mas').addEventListener('click', () => {
    if (!restFinMs) return;
    restFinMs += 15_000;
    tickRest();
  });

  // ---------- Cuenta atrás (plancha) ----------
  // 5 s para colocarse y luego el tiempo fijo de la serie. Reloj de pared, como
  // el descanso: si la pantalla se bloquea, al volver se resincroniza.
  const PREPARACION_SEG = 5;
  let cuenta: { e: EjercicioDef; i: number; fase: 'prep' | 'serie'; inicioMs: number; finMs: number; ultimo: number } | null =
    null;
  let cuentaInterval: ReturnType<typeof setInterval> | undefined;

  function empezarCuenta(e: EjercicioDef, i: number) {
    pararRest();
    asegurarAudio();
    void pedirPantalla();
    const ahora = Date.now();
    cuenta = { e, i, fase: 'prep', inicioMs: ahora, finMs: ahora + PREPARACION_SEG * 1000, ultimo: PREPARACION_SEG + 1 };
    $('cuenta-bar').classList.remove('hidden');
    $('cuenta-bar').classList.add('flex');
    clearInterval(cuentaInterval);
    cuentaInterval = setInterval(tickCuenta, 200);
    tickCuenta();
  }

  function tickCuenta() {
    if (!cuenta) return;
    const restante = Math.ceil((cuenta.finMs - Date.now()) / 1000);
    if (restante <= 0) {
      if (cuenta.fase === 'serie') return terminarCuenta(true);
      const ahora = Date.now();
      const seg = cuenta.e.segObjetivo ?? 60;
      cuenta = { ...cuenta, fase: 'serie', inicioMs: ahora, finMs: ahora + seg * 1000, ultimo: seg + 1 };
      bip(1320, 0.35);
      return tickCuenta();
    }
    // Pitido corto en los tres últimos segundos de cada fase
    if (restante < cuenta.ultimo && restante <= 3) bip(660, 0.08);
    cuenta.ultimo = restante;
    $('cuenta-fase').textContent = cuenta.fase === 'prep' ? 'Colócate' : `${cuenta.e.nombre} · S${cuenta.i + 1}`;
    $('cuenta-tiempo').textContent = cuenta.fase === 'prep' ? String(restante) : fmtCrono(restante);
  }

  function terminarCuenta(completa: boolean) {
    if (!cuenta) return;
    const { e, i, fase, inicioMs, finMs } = cuenta;
    cuenta = null;
    clearInterval(cuentaInterval);
    $('cuenta-bar').classList.add('hidden');
    $('cuenta-bar').classList.remove('flex');
    if (!necesitaPantalla()) soltarPantalla();
    if (fase === 'prep') return;
    const s = regDe(e).series[i];
    s.segundos = Math.round(((completa ? finMs : Date.now()) - inicioMs) / 1000);
    if (completa) pitido();
    registrar(e, i, completa ? 'completada' : 'fallo');
  }

  $('cuenta-parar').addEventListener('click', () => terminarCuenta(false));

  // ---------- Acciones ----------
  async function finalizar() {
    const marcadas = sesion!.ejercicios.reduce((n, e) => n + e.series.filter((s) => s.estado !== 'pendiente').length, 0);
    if (marcadas === 0) {
      if (confirm('No has marcado ninguna serie. ¿Descartar la sesión?')) {
        await descartarSesion(sesion!.id);
        location.href = '/';
      }
      return;
    }
    const pendientes = seriesContables().filter((s) => s.estado === 'pendiente').length;
    if (pendientes > 0 && !confirm(`Quedan ${pendientes} series sin marcar. ¿Finalizar igual?`)) return;
    // Un crono de cardio en marcha se cierra con lo que lleve
    for (const { e, c } of cronosCardio()) {
      if (!c.cronoInicioISO) continue;
      pararCrono(c);
      const s = regDe(e).series[0];
      s.segundos = Math.round(c.cronoAcumSeg ?? 0);
      if (s.estado === 'pendiente' && s.segundos >= 60) s.estado = 'completada';
    }
    soltarPantalla();
    pararRest();
    await finalizarSesion(sesion!);
    renderFin();
  }

  $('btn-empezar').addEventListener('click', async () => {
    sesion = crearSesion(rutina, dia, calcularSugerencias(dia));
    cardIdx = 0;
    await guardarSesion(sesion);
    renderSesion();
  });

  $('btn-prev').addEventListener('click', () => {
    if (cardIdx > 0) {
      cardIdx--;
      renderCard();
    }
  });
  $('btn-next').addEventListener('click', () => {
    const gs = grupos(dia);
    if (cardIdx < gs.length - 1) {
      cardIdx++;
      renderCard();
    } else {
      void finalizar();
    }
  });
  $('btn-finalizar').addEventListener('click', () => void finalizar());

  $('in-sueno').addEventListener('change', () => {
    const v = ($('in-sueno') as HTMLInputElement).value;
    sesion!.suenoH = v === '' ? null : Number(v);
    void guardarSesion(sesion!);
  });
  $('in-notas').addEventListener('change', () => {
    sesion!.notas = ($('in-notas') as HTMLTextAreaElement).value;
    void guardarSesion(sesion!);
  });

  // ---------- Arranque ----------
  const borrador = await buscarBorrador();
  if (borrador) {
    const diaBorrador = rutina.dias.find((d) => d.id === borrador.diaId);
    $('dlg-borrador-texto').textContent = `${diaBorrador ? tituloDe(diaBorrador) : 'Sesión'} del ${new Date(
      `${borrador.fecha}T12:00:00`,
    ).toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric' })} en borrador. ¿La retomas?`;
    const dlg = $('dlg-borrador') as HTMLDialogElement;
    // Sin escape: cerrar sin decidir dejaría la pantalla vacía y borradores duplicados
    dlg.addEventListener('cancel', (ev) => ev.preventDefault());
    dlg.showModal();
    $('dlg-borrador-retomar').addEventListener('click', () => {
      dlg.close();
      sesion = borrador;
      if (diaBorrador) dia = diaBorrador;
      cardIdx = 0;
      renderSesion();
    });
    $('dlg-borrador-descartar').addEventListener('click', async () => {
      await descartarSesion(borrador.id);
      dlg.close();
      renderInicio();
    });
  } else {
    renderInicio();
  }
</script>
